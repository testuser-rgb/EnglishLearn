{
    "@platforms": ["android", "iPhone", "iPad"],
    "id": "H5XWYY60D01",
    "name": "学位英语备考",
    "version": {
        "name": "1.0.0",
        "code": "100"
    },
    "description": "江苏联盟学位英语备考系统 · 60天两阶段 · 离线可用",
    "keywords": "学位英语,背词,备考",
    "developer": {
        "name": "",
        "email": "",
        "url": ""
    },
    "permissions": {
        "Storage": {
            "description": "本地保存学习进度（plus.storage）"
        }
    },
    "plus": {
        "distribute": {
            "apple": {
                "appid": "",
                "mobileprovision": "",
                "password": "",
                "p12": "",
                "devices": "any",
                "orientation": ["portrait"]
            },
            "google": {
                "packagename": "com.example.xwyy.beikao",
                "keystore": "",
                "password": "",
                "aliasname": "",
                "permissionPhoneState": {
                    "request": "none",
                    "prompt": ""
                }
            }
        },
        "compatible": {
            "ignoreVersion": false
        },
        "allowsInlineMediaPlayback": true,
        "statusbar": {
            "immersed": "supportedDevice"
        },
        "popGesture": "close",
        "launch_path": "index.html",
        "error": {
            "url": "none"
        },
        "orientation": {
            "default": "portrait"
        }
    }
